<%# locals: (data:) -%>
<section class="container block">
  <% if data.heading.present? %><h2><%= data.heading %></h2><% end %>
  <% if data.body.present? %><div class="muted lead"><%= website_rich_text data.body %></div><% end %>
  <div class="grid grid--<%= data.columns.presence || 3 %>">
    <% data.items.each_with_index do |item, index| %>
      <%# herb:key index %>
      <div class="card">
        <h3><%= item.title %></h3>
        <div class="muted"><%= website_rich_text item.body %></div>
        <% if (href = website_href(item.link)) %><a href="<%= href %>">Learn more →</a><% end %>
      </div>
    <% end %>
  </div>
</section>
