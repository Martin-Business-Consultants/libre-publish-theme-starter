<%# locals: (data:) -%>
<%# Questions that open in place, and the same for search engines (FAQPage). %>
<% items = Array(data.items).select { it.question.present? } %>
<section class="container container--narrow block faq">
  <% if data.heading.present? %><h2><%= data.heading %></h2><% end %>
  <% if data.body.present? %><div class="muted"><%= website_rich_text data.body %></div><% end %>
  <% items.each_with_index do |item, index| %>
    <%# herb:key index %>
    <details>
      <summary><%= item.question %></summary>
      <div class="prose"><%= website_markdown item.answer %></div>
    </details>
  <% end %>
  <%= website_json_ld({"@context" => "https://schema.org", "@type" => "FAQPage",
        "mainEntity" => items.map { {"@type" => "Question", "name" => starter_plain(it.question),
          "acceptedAnswer" => {"@type" => "Answer", "text" => starter_plain(it.answer)}} }}) if items.any? %>
</section>
