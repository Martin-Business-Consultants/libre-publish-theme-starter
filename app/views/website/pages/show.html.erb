<%# locals: (page:) -%>
<%# A page: its blocks, top to bottom. A page whose first block isn't a hero
    gets its title as a heading. %>
<% content_for :head, website_seo_tags(page) %>
<% unless Array(page.blocks).first.to_h["type"] == "hero" %>
  <div class="container page-title"><h1><%= page.title %></h1></div>
<% end %>
<%= website_blocks page %>
